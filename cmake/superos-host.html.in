<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@BROOKESIA_HOST_TITLE@</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: system-ui, sans-serif;
      background: #101214;
    }

    * { box-sizing: border-box; }

    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
    }

    body {
      display: grid;
      place-items: center;
      background: radial-gradient(circle at 50% 35%, #293038 0, #15191d 45%, #0b0d0f 100%);
    }

    #screen {
      position: relative;
      display: grid;
      place-items: center;
      max-width: 100vw;
      max-height: 100vh;
      overflow: hidden;
      background: #000;
      box-shadow: 0 1rem 4rem rgb(0 0 0 / 55%);
    }

    #canvas {
      display: block;
      max-width: 100vw;
      max-height: 100vh;
      width: auto;
      height: auto;
      border: 0;
      outline: 0;
      background: #000;
    }

    #status {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 2rem;
      color: #d9e0e6;
      background: #101418;
      text-align: center;
      transition: opacity 180ms ease;
    }

    #status[hidden] {
      display: none;
    }
  </style>
</head>
<body>
  <main id="screen">
    <canvas id="canvas" oncontextmenu="event.preventDefault()" tabindex="-1"></canvas>
    <div id="status" role="status" aria-live="polite">Loading Brookesia…</div>
  </main>

  <script>
    const canvas = document.getElementById('canvas');
    const status = document.getElementById('status');

    canvas.addEventListener('webglcontextlost', (event) => {
      event.preventDefault();
      status.hidden = false;
      status.textContent = 'The graphics context was lost. Reload this page to continue.';
    });

    var Module = {
      canvas,
      print: (...args) => console.log(...args),
      printErr: (...args) => console.error(...args),
      setStatus(text) {
        status.textContent = text || '';
        status.hidden = !text;
      },
      totalDependencies: 0,
      monitorRunDependencies(left) {
        this.totalDependencies = Math.max(this.totalDependencies, left);
        this.setStatus(left
          ? `Preparing… (${this.totalDependencies - left}/${this.totalDependencies})`
          : '');
      }
    };

    window.addEventListener('error', () => Module.setStatus('Unable to start Brookesia. See the browser console for details.'));
    window.addEventListener('unhandledrejection', () => Module.setStatus('Unable to start Brookesia. See the browser console for details.'));
  </script>
  <script async src="@BROOKESIA_HOST_SCRIPT@"></script>
</body>
</html>
