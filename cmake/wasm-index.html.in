<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Browser-hosted WebAssembly builds of ESP-Brookesia and Brookesia-Brookesia.">
  <title>Brookesia WebAssembly demos</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #f7f8fb;
      background: #090d14;
      font-synthesis: none;
    }

    * { box-sizing: border-box; }

    html { min-width: 320px; background: #090d14; }

    body {
      min-height: 100vh;
      margin: 0;
      background:
        radial-gradient(circle at 12% 8%, rgb(55 99 255 / 20%), transparent 31rem),
        radial-gradient(circle at 88% 12%, rgb(0 214 168 / 14%), transparent 28rem),
        linear-gradient(160deg, #101725 0%, #090d14 48%, #070a10 100%);
    }

    a { color: inherit; }

    .site-shell {
      width: min(1120px, calc(100% - 40px));
      margin: 0 auto;
      padding: 72px 0 40px;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
      align-items: end;
      padding-bottom: 42px;
      border-bottom: 1px solid rgb(255 255 255 / 10%);
    }

    .kicker,
    .build-card__eyebrow {
      color: #75e5ca;
      font-size: .75rem;
      font-weight: 750;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    h1 {
      max-width: 760px;
      margin: 14px 0 16px;
      font-size: clamp(2.6rem, 7vw, 5.5rem);
      font-weight: 760;
      letter-spacing: -.055em;
      line-height: .96;
    }

    .hero p {
      max-width: 680px;
      margin: 0;
      color: #aeb8c8;
      font-size: clamp(1rem, 2vw, 1.15rem);
      line-height: 1.7;
    }

    .wasm-mark {
      display: grid;
      width: 108px;
      height: 108px;
      place-items: center;
      border: 1px solid rgb(117 229 202 / 38%);
      border-radius: 30px;
      color: #75e5ca;
      background: linear-gradient(145deg, rgb(117 229 202 / 16%), rgb(82 104 255 / 14%));
      box-shadow: 0 24px 80px rgb(0 0 0 / 35%);
      font-weight: 800;
      letter-spacing: -.05em;
    }

    .section-heading {
      display: flex;
      gap: 24px;
      align-items: baseline;
      justify-content: space-between;
      margin: 46px 0 20px;
    }

    .section-heading h2 { margin: 0; font-size: 1.35rem; }
    .section-heading p { margin: 0; color: #78869b; font-size: .9rem; }

    .build-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr));
      gap: 18px;
    }

    .build-card {
      display: flex;
      min-height: 280px;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      border: 1px solid rgb(255 255 255 / 11%);
      border-radius: 22px;
      background: linear-gradient(145deg, rgb(24 33 50 / 92%), rgb(13 19 30 / 88%));
      box-shadow: 0 22px 70px rgb(0 0 0 / 22%);
      transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
    }

    .build-card:hover {
      transform: translateY(-3px);
      border-color: rgb(117 229 202 / 34%);
      box-shadow: 0 28px 80px rgb(0 0 0 / 30%);
    }

    .build-card__body { padding: 28px 28px 20px; }
    .build-card h2 { margin: 12px 0 12px; font-size: 1.45rem; letter-spacing: -.025em; }
    .build-card p { margin: 0; color: #9eabba; line-height: 1.6; }

    .build-card__footer {
      display: flex;
      gap: 16px;
      align-items: center;
      justify-content: space-between;
      padding: 18px 20px 18px 28px;
      border-top: 1px solid rgb(255 255 255 / 8%);
      background: rgb(3 8 15 / 25%);
    }

    .build-path {
      overflow: hidden;
      color: #718096;
      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
      font-size: .72rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .launch-button {
      flex: none;
      padding: 10px 14px;
      border-radius: 12px;
      color: #07110f;
      background: #75e5ca;
      font-size: .86rem;
      font-weight: 750;
      text-decoration: none;
    }

    .launch-button:hover { background: #9af0dc; }
    .launch-button:focus-visible, .repo-link:focus-visible { outline: 3px solid #7187ff; outline-offset: 3px; }

    .repositories {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }

    .repo-link {
      display: block;
      padding: 18px 20px;
      border: 1px solid rgb(255 255 255 / 9%);
      border-radius: 16px;
      color: #cbd3df;
      background: rgb(255 255 255 / 3%);
      text-decoration: none;
    }

    .repo-link:hover { border-color: rgb(113 135 255 / 55%); background: rgb(113 135 255 / 9%); }
    .repo-link strong { display: block; margin-bottom: 5px; color: #f5f7fb; }
    .repo-link span { color: #78869b; font-size: .82rem; }

    footer {
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid rgb(255 255 255 / 8%);
      color: #647186;
      font-size: .82rem;
    }

    @media (max-width: 680px) {
      .site-shell { width: min(100% - 28px, 1120px); padding-top: 42px; }
      .hero { grid-template-columns: 1fr; gap: 28px; }
      .wasm-mark { width: 82px; height: 82px; border-radius: 22px; grid-row: 1; }
      .section-heading { display: block; }
      .section-heading p { margin-top: 7px; }
      .build-card { min-height: 250px; }
      .build-card__footer { align-items: stretch; flex-direction: column; }
      .launch-button { text-align: center; }
    }

    @media (prefers-reduced-motion: reduce) {
      .build-card { transition: none; }
    }
  </style>
</head>
<body>
  <main class="site-shell">
    <header class="hero">
      <div>
        <span class="kicker">ESP-Brookesia in the browser</span>
        <h1>Brookesia WebAssembly demos</h1>
        <p>Run the current browser builds without installing ESP-IDF or flashing a device. Choose a demo below; the first load may take a few seconds while its WebAssembly bundle starts.</p>
      </div>
      <div class="wasm-mark" aria-hidden="true">WASM</div>
    </header>

    <section aria-labelledby="builds-heading">
      <div class="section-heading">
        <h2 id="builds-heading">Available builds</h2>
        <p>Generated from the builds currently staged by <code>host.ps1</code></p>
      </div>
      <div class="build-grid">
@BROOKESIA_BUILD_CARDS@
      </div>
    </section>

    <section aria-labelledby="repositories-heading">
      <div class="section-heading">
        <h2 id="repositories-heading">Source repositories</h2>
        <p>Project sources, native application, and framework</p>
      </div>
      <div class="repositories">
        <a class="repo-link" href="https://github.com/BillyBag2/brookesia-brookesia-wasm">
          <strong>Brookesia-Brookesia WASM</strong>
          <span>Browser builds and host tooling</span>
        </a>
        <a class="repo-link" href="https://github.com/BillyBag2/brookesia-brookesia">
          <strong>Brookesia-Brookesia</strong>
          <span>Native SuperOS application and board resources</span>
        </a>
        <a class="repo-link" href="https://github.com/BillyBag2/brookesia-brookesia/releases">
          <strong>Brookesia-Brookesia releases</strong>
          <span>Download published native firmware builds</span>
        </a>
        <a class="repo-link" href="https://github.com/BillyBag2/esp-brookesia">
          <strong>ESP-Brookesia WASM fork</strong>
          <span>WebAssembly-compatible framework components</span>
        </a>
        <a class="repo-link" href="https://github.com/espressif/esp-brookesia">
          <strong>ESP-Brookesia upstream</strong>
          <span>Original Espressif framework</span>
        </a>
      </div>
    </section>

    <footer>These are development builds. Browser hardware integrations may differ from an ESP32 target.</footer>
  </main>
</body>
</html>
